<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" version="4.0" method="upgrade" group="editor">
    <name>plg_editor_ext_articleGalleryBtn</name>
    <author>meme1991</author>
    <creationDate>2025-11-12</creationDate>
    <version>1.0.0</version>
    <description>Editor button to open article gallery (Joomla 4 compatible)</description>

    <files>
        <filename plugin="ext_articleGalleryBtn">plg_editor_ext_articleGalleryBtn.php</filename>
